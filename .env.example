# ---- AWS ----
AWS_REGION=us-east-1
AWS_PROFILE=default

# ---- Bedrock models ----
# Nova Pro cross-region inference profile
NOVA_MODEL_ID=us.amazon.nova-pro-v1:0
# Decision / orchestrator reasoning model
DECISION_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ---- AgentCore resources (fill in after running scripts/create_*.py) ----
MEMORY_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
CODE_INTERPRETER_ID=

# ---- Demo defaults ----
DEMO_TENANT_ID=demo-tenant
DEMO_BUCKET=ugc-moderation-demo
DEFAULT_CONFIDENCE_THRESHOLD=75.0

# ---- Streamlit client mode ----
# local  = call Strands graph directly in-process (fast iteration)
# remote = call deployed AgentCore Runtime via invoke_agent_runtime
CLIENT_MODE=local
AGENT_RUNTIME_ARN=
