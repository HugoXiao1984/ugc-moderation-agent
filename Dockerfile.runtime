# AgentCore Runtime container (NOT the ECS web server).
#
# Runs the AgentCore entrypoint `ugc_moderation.app` which serves the runtime
# contract: GET /ping + POST /invocations on port 8080. This is distinct from
# the repo-root Dockerfile, which runs the ECS FastAPI web server (backend.api)
# on 8000. The two targets share the same source tree but need different CMDs,
# so the Runtime gets its own Dockerfile.
#
# Built in the cloud by CodeBuild (ARM64) — weak local networks only upload the
# source zip; pip install runs on AWS.
FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    DOCKER_CONTAINER=1

# apt via Tsinghua mirror (deb822 sources on bookworm).
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml requirements.txt ./

# Base deps + the OpenTelemetry distro AgentCore observability expects.
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install "aws-opentelemetry-distro>=0.12.0"

COPY src ./src
COPY policies_scripts ./policies_scripts

ENV PYTHONPATH=/app/src:/app

# AgentCore Runtime contract: /ping + /invocations on 8080 (app.run default).
EXPOSE 8080

# opentelemetry-instrument wraps the entrypoint so traces flow to the GenAI
# Observability dashboard. `python -m ugc_moderation.app` runs app.run().
CMD ["opentelemetry-instrument", "python", "-m", "ugc_moderation.app"]
